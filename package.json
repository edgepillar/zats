{
  "name": "zats",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Zats hidden in a photo. A Zenon account key in the pixels of a PNG.",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "preview:lan": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "predev": "node scripts/copy-pow.mjs",
    "prebuild": "node scripts/copy-pow.mjs",
    "prepreview": "node scripts/copy-pow.mjs",
    "e2e": "node e2e/flow.mjs"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "5.3.0",
    "fast-png": "8.0.0",
    "pretendard": "1.3.9",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "znn-typescript-sdk": "1.0.5"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "puppeteer-core": "23.11.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.4"
  }
}
